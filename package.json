{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:gateway": "pnpm nx serve gateway",
    "dev:web": "pnpm nx serve web",
    "dev:mobile": "pnpm nx start mobile",
    "dev:marketing": "pnpm nx serve marketing",
    "dev": "concurrently --names gateway,web --prefix-colors magenta,cyan \"pnpm dev:gateway\" \"pnpm dev:web\"",
    "aws:up": "docker compose up -d --wait dynamodb ses",
    "aws:down": "docker compose down",
    "aws:seed": "node --conditions=@org/source --import jiti/register infra/aws-local/seed.ts",
    "aws:tables": "node --conditions=@org/source --import jiti/register infra/aws-local/create-tables.ts",
    "typecheck": "pnpm nx run-many -t typecheck",
    "test": "pnpm nx run-many -t test",
    "build": "pnpm nx run-many -t build --exclude=mobile",
    "e2e": "pnpm nx e2e web-e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:affected": "pnpm nx affected -t typecheck test && pnpm nx affected -t build --exclude=mobile",
    "dev:local": "bash tools/scripts/dev-local.sh",
    "dev:data": "node --conditions=@org/source --import jiti/register infra/aws-local/run-data-function.ts"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.14.5",
    "@babel/runtime": "~7.27.6",
