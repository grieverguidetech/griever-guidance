# Local AWS stack for the aws-be branch (docs/aws-local.md).
# Names only. The defaults in libs/data-aws already match `pnpm aws:up`, so you can leave all of
# these unset. Never put real AWS keys in this file.

# One endpoint for every AWS service. Local: DynamoDB Local.
# AWS_ENDPOINT_URL=http://localhost:8100
# Per-service endpoints win over AWS_ENDPOINT_URL.
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8100
# AWS_ENDPOINT_URL_SESV2=http://localhost:8105

# Fake credentials for local use. DynamoDB Local accepts letters and digits only.
# AWS_ACCESS_KEY_ID=localfakekey
# AWS_SECRET_ACCESS_KEY=localfakesecret
# AWS_REGION=us-east-1

# Table names (plan v4).
# GG_DATA_TABLE=gg-data
# GG_CONTENT_TABLE=gg-content

# Data function (docs/aws-local.md). Names only; take the values from the auth provider.
# DATA_AUTH_ISSUER=
# DATA_AUTH_JWKS_URL=
# DATA_AUTH_AUTHORIZED_PARTIES=

# CI only: make the integration tests fail when the local stack is not reachable.
# AWS_LOCAL_REQUIRED=true
