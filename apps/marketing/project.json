{
  "name": "marketing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/marketing/src",
  "implicitDependencies": ["tokens"],
  "targets": {
    "serve": {
      "command": "astro dev",
      "options": {
        "cwd": "apps/marketing"
      }
    },
    "build": {
      "command": "astro build",
      "options": {
        "cwd": "apps/marketing"
      }
    },
    "test": {
      "command": "node tools/scripts/generate-token-css.mjs --check",
      "dependsOn": ["tokens:build"],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/scripts/generate-token-css.mjs"
      ]
    }
  }
}
