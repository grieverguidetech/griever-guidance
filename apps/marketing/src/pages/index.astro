---
import '../styles/tokens.generated.css';
import '../styles/page.css';

const webUrl = import.meta.env.PUBLIC_WEB_URL ?? 'https://web.grieversguidance.com/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grievers Guidance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..400,100&family=Nunito+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Hero -->
    <section class="section hero">
      <h1>Grievers Guidance</h1>
      <p>
        When you lose someone, the last thing you should have to manage is
        logistics. Send funeral and service details to the people who need to
        know, from your phone, in minutes.
      </p>
      <a class="button" href={webUrl}>Download the app</a>
    </section>

    <!-- How it works -->
    <section class="section steps">
      <h2>How it works</h2>
      <ol>
        <li class="step">
          <span class="step-number">1</span>
          <div>
            <strong>Choose a template</strong>
            <p>
              Select from funeral service details, a passing announcement, or a
              celebration of life.
            </p>
          </div>
        </li>
        <li class="step">
          <span class="step-number">2</span>
          <div>
            <strong>Fill in the details</strong>
            <p>
              Enter the name, date, time, and location. We fill in the rest of
              the message.
            </p>
          </div>
        </li>
        <li class="step">
          <span class="step-number">3</span>
          <div>
            <strong>Send to your contacts</strong>
            <p>
              Choose who needs to know and send. Everyone receives a clear,
              compassionate text message.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p>Grievers Guidance &mdash; Built with care.</p>
    </footer>
  </body>
</html>
