VITE_API_URL=http://localhost:3001

# Sign-up/sign-in. Off unless exactly "true" (apps/web/src/lib/features.ts).
VITE_FEATURE_AUTH=false
# AI obituary drafting. Off unless exactly "true" — the button shows disabled, "in beta".
VITE_FEATURE_OBITUARY_DRAFTING=false
# Paying for tasks after the first announcement. Off unless exactly "true". No screen reads it yet.
VITE_FEATURE_PAYMENTS=false
# The web editor (Overview, The person, Service). Off unless exactly "true". On in production.
VITE_FEATURE_CMS=false

# Accounts (Clerk). Only read when VITE_FEATURE_AUTH is "true". Names only, no values here.
# Publishable key only (starts pk_). Never put a secret key (sk_) in a client.
VITE_CLERK_PUBLISHABLE_KEY=
