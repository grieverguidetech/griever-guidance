{
  "name": "@org/agent",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "agent",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "wrangler deploy --dry-run --outdir apps/agent/dist --config apps/agent/wrangler.toml",
          "cwd": "{workspaceRoot}",
          "env": {
            "WRANGLER_BUILD_CONDITIONS": "@org/source,workerd,worker,browser"
          }
        }
      }
    }
  },
  "dependencies": {
    "@griever/agent-workflow": "workspace:*",
    "@griever/copy": "workspace:*",
    "@griever/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
