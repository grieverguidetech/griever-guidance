{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/agent-workflow/tsconfig.lib.json"
    },
    {
      "path": "../../libs/copy/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/tsconfig.lib.json"
