{
  "name": "@org/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/mobile && NX_DAEMON=false pnpm nx run-many -t build -p shared api-client hooks contacts copy tokens"
  },
  "nx": {
    "name": "mobile",
    "targets": {
      "start": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "cwd": "apps/mobile",
          "command": "expo start"
        },
        "dependsOn": [
          "build-deps",
          "watch-deps"
        ]
      },
      "export": {
        "dependsOn": [
          "^export",
          "build-deps"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/coverage"
        ],
        "options": {
          "command": "jest --config jest.config.cjs",
          "cwd": "apps/mobile"
        }
      }
    }
  },
  "dependencies": {
    "@clerk/expo": "4.13.0",
    "@expo-google-fonts/source-serif-4": "0.4.1",
    "@griever/api-client": "workspace:*",
    "@griever/contacts": "workspace:*",
    "@griever/copy": "workspace:*",
    "@griever/hooks": "workspace:*",
    "@griever/shared": "workspace:*",
    "@griever/tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@testing-library/react-native": "13.3.3",
    "expo": "58.0.23",
    "expo-auth-session": "58.0.17",
    "expo-clipboard": "58.0.4",
    "expo-contacts": "58.0.10",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.11",
    "expo-mail-composer": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.0.7",
    "jest-expo": "58.0.14",
    "metro-config": "0.87.1",
    "metro-resolver": "0.87.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "1.5.3",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "jest": "30.5.2",
    "react-test-renderer": "19.3.0"
  }
}
