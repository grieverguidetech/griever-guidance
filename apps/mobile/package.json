{
  "name": "@org/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/mobile"
  },
  "nx": {
    "name": "mobile",
    "targets": {
      "start": {
        "dependsOn": [
          "build-deps",
          "watch-deps"
        ]
      },
      "export": {
        "dependsOn": [
          "^export",
          "build-deps"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/coverage"
        ],
        "options": {
          "command": "jest --config jest.config.cjs",
          "cwd": "apps/mobile"
        }
      }
    }
  },
  "dependencies": {
    "@expo/metro-config": "54.0.15",
    "@griever/shared": "workspace:*",
    "@griever/hooks": "workspace:*",
    "@griever/api-client": "workspace:*",
    "@griever/contacts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@testing-library/react-native": "13.3.3",
    "expo": "54.0.34",
    "expo-contacts": "15.0.11",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "6.0.9",
    "jest-expo": "54.0.17",
    "metro-config": "0.83.7",
    "metro-resolver": "0.83.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "1.5.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "jest": "29.7.0",
    "react-test-renderer": "19.1.0"
  }
}
