EXPO_PUBLIC_API_URL=http://localhost:3001
# Accounts (Supabase). Names only here; put real values in your own untracked .env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to true to show the account screens. Leave unset to keep the app as it is today.
EXPO_PUBLIC_FEATURE_AUTH=
# Paying for tasks after the first announcement. Off unless exactly "true". No screen reads it yet.
EXPO_PUBLIC_FEATURE_PAYMENTS=
