EXPO_PUBLIC_API_URL=http://localhost:3001
# Set to true to show the account screens (needs the Clerk key below). Leave unset to keep the app as it is today.
EXPO_PUBLIC_FEATURE_AUTH=
# Background sync of the person's details to the account. Off unless exactly "true"; runs only when signed in, so set EXPO_PUBLIC_FEATURE_AUTH=true too.
# Dev and preview (TestFlight) builds set both to true in eas.json; production leaves both unset.
EXPO_PUBLIC_FEATURE_SYNC=
# Paying for tasks after the first announcement. Off unless exactly "true". No screen reads it yet.
EXPO_PUBLIC_FEATURE_PAYMENTS=
# Accounts (Clerk). Names only here; put real values in your own untracked .env.local.
# Publishable key only (starts pk_). Never put a secret key (sk_) in a client.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
