{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/gateway-sync/tsconfig.lib.json"
    },
    {
      "path": "../../libs/gateway-messages/tsconfig.lib.json"
    },
    {
      "path": "../../libs/identity/tsconfig.lib.json"
    }
  ],
  "exclude": [
