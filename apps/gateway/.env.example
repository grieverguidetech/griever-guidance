PORT=3001
ANTHROPIC_API_KEY=

# Comma-separated allowed CORS origins — no "allow all" mode, an empty value
# blocks every cross-origin request (see apps/gateway/src/worker.ts).
# Real value for local dev lives in .env.local (git-ignored).
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Supabase accounts (see infra/supabase). Names only here; real values live in
# .env.local. Unset means GET/PUT /me/profile answer 503. Never add a
# service-role key: the gateway acts as the signed-in user so RLS applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Invite emails via Resend (POST /invites). Names only; real values live in
# .env.local. Unset means POST /invites answers 503.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
WEB_URL=

# Clerk accounts. Names only; real values live in .env.local. The gateway
# verifies Clerk session tokens against the issuer's keys; it holds no Clerk
# secret key. CLERK_ISSUER is the https Frontend API URL. CLERK_AUTHORIZED_PARTIES
# is a comma-separated list of allowed token origins (the `azp` claim).
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=

# Data function (GET/PUT /me/profile). DATA_FUNCTION_URL is the Lambda function
# URL origin, no path. For local dev use http://127.0.0.1:3002 (pnpm dev:data);
# loopback calls are unsigned and need no key pair. Otherwise the gateway signs
# calls with SigV4 using the key pair below. A remote URL also needs
# DATA_FUNCTION_REGION (this project: us-east-2); there is no default. Unset URL means 503.
DATA_FUNCTION_URL=
DATA_FUNCTION_REGION=
DATA_FUNCTION_ACCESS_KEY_ID=
DATA_FUNCTION_SECRET_ACCESS_KEY=
