PORT=3001
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ANTHROPIC_API_KEY=

# Local Convex backend only (see infra/convex/README.md). Real values go in
# .env (git-ignored), not here. The gateway is the only thing that talks to
# Convex directly — apps/web only ever calls the gateway.
#
# Production uses Convex Cloud instead, selected via CONVEX_DEPLOYMENT (local
# machine) or CONVEX_DEPLOY_KEY (CI) — see infra/convex/README.md's
# "Production" section. Those never go in a file; they're GitHub secrets.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_SITE_URL=http://127.0.0.1:3211
