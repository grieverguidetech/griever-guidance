PORT=3001
ANTHROPIC_API_KEY=

# Comma-separated allowed CORS origins — no "allow all" mode, an empty value
# blocks every cross-origin request (see apps/gateway/src/worker.ts). The
# same list also bounds where `libs/identity` will send a browser back to
# after sign-in (its `redirectTo` allowlist) — see GATEWAY_BASE_URL below.
# Real value for local dev lives in .env.local (git-ignored).
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# libs/identity — Facebook/Instagram sign-up and sign-in (see CLAUDE.md's
# "Identity" section). Leaving a provider's id/secret blank simply disables
# that provider's /auth/<provider>/start route (404) rather than crashing.
#
# Facebook Login app (developers.facebook.com) — public_profile + email,
# no app review required for those two scopes.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram's own "Business Login for Instagram" app — a separate app/secret
# from the Facebook one above. Only Business/Creator Instagram accounts can
# sign in at all, and Instagram never supplies an email address.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# This gateway's own externally-reachable base URL — used to build the
# `redirect_uri` Facebook/Instagram send the browser back to
# (`${GATEWAY_BASE_URL}/auth/<provider>/callback`). Must exactly match what's
# registered in each provider's app dashboard.
GATEWAY_BASE_URL=http://localhost:3001
# Signs/verifies the OAuth `state` param and the session bearer token
# (HMAC-SHA256) — a long random string, generated once per environment.
IDENTITY_SESSION_SECRET=
# Shared secret between the gateway and Convex's identity.ts functions —
# proves a call to findOrCreateIdentity/getIdentityAndProfile came from this
# gateway, not directly from a browser. Set the same value here and via
# `npx convex env set IDENTITY_SERVICE_SECRET <value>` (see
# infra/convex/README.md) — the two must match exactly.
IDENTITY_SERVICE_SECRET=

# Local Convex backend only (see infra/convex/README.md). Real values go in
# .env (git-ignored), not here. The gateway is the only thing that talks to
# Convex directly — apps/web only ever calls the gateway.
#
# Production uses Convex Cloud instead, selected via CONVEX_DEPLOYMENT (local
# machine) or CONVEX_DEPLOY_KEY (CI) — see infra/convex/README.md's
# "Production" section. Those never go in a file; they're GitHub secrets.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_SITE_URL=http://127.0.0.1:3211
