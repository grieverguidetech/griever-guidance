{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/vitest",
    "tsBuildInfoFile": "out-tsc/vitest/tsconfig.spec.tsbuildinfo",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
