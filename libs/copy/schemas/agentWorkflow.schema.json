{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the agent workflow tools",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "startWorkflowTitle",
    "startWorkflowDescription",
    "nextStepTitle",
    "nextStepDescription",
    "agentInstruction",
    "handOff",
    "actorYou",
    "actorAssistant",
    "whatDoneMeans",
    "allDone"
  ],
  "properties": {
    "startWorkflowTitle": { "type": "string", "minLength": 1 },
    "startWorkflowDescription": { "type": "string", "minLength": 1 },
    "nextStepTitle": { "type": "string", "minLength": 1 },
    "nextStepDescription": { "type": "string", "minLength": 1 },
    "agentInstruction": { "type": "string", "minLength": 1 },
    "handOff": { "type": "string", "minLength": 1 },
    "actorYou": { "type": "string", "minLength": 1 },
    "actorAssistant": { "type": "string", "minLength": 1 },
    "whatDoneMeans": { "type": "string", "minLength": 1 },
    "allDone": { "type": "string", "minLength": 1 }
  }
}
