{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the phone-only words on Your account: required or optional in a field's spoken name, Try again, and the sign-in and support words (the rest comes from account.json, which web also reads)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "required",
    "optional",
    "retry",
    "manageSignInHint",
    "supportButton",
    "supportHint",
    "supportFailed",
    "manageSignInFailed"
  ],
  "properties": {
    "required": {
      "$ref": "#/$defs/text"
    },
    "optional": {
      "$ref": "#/$defs/text"
    },
    "retry": {
      "$ref": "#/$defs/text"
    },
    "manageSignInHint": {
      "$ref": "#/$defs/text"
    },
    "supportButton": {
      "$ref": "#/$defs/text"
    },
    "supportHint": {
      "$ref": "#/$defs/text"
    },
    "supportFailed": {
      "$ref": "#/$defs/text"
    },
    "manageSignInFailed": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
