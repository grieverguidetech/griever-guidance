{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the phone-only Ready to send screen (the rest comes from review.json, which web also reads)",
  "type": "object",
  "additionalProperties": false,
  "required": ["changeService", "changeThanks", "addNote", "notePlaceholder", "to", "and", "everyoneYouTold", "andMore", "change", "changeName", "choose", "fine", "shareInstead", "placesOne", "placesMany", "placesNone", "placesUnavailable", "placeFilled", "placesHint"],
  "properties": {
    "changeService": { "$ref": "#/$defs/text" },
    "changeThanks": { "$ref": "#/$defs/text" },
    "addNote": { "$ref": "#/$defs/text" },
    "notePlaceholder": { "$ref": "#/$defs/text" },
    "to": { "$ref": "#/$defs/text" },
    "and": { "$ref": "#/$defs/text" },
    "everyoneYouTold": { "$ref": "#/$defs/text" },
    "andMore": { "$ref": "#/$defs/text" },
    "change": { "$ref": "#/$defs/text" },
    "changeName": { "$ref": "#/$defs/text" },
    "choose": { "$ref": "#/$defs/text" },
    "fine": { "$ref": "#/$defs/text" },
    "shareInstead": { "$ref": "#/$defs/text" },
    "placesOne": { "$ref": "#/$defs/text" },
    "placesMany": { "$ref": "#/$defs/text" },
    "placesNone": { "$ref": "#/$defs/text" },
    "placesUnavailable": { "$ref": "#/$defs/text" },
    "placeFilled": { "$ref": "#/$defs/text" },
    "placesHint": { "$ref": "#/$defs/text" }
  },
  "$defs": { "text": { "type": "string", "minLength": 1 } }
}
