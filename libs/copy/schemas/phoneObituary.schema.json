{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the phone-only obituary text editor on Share obituary (the rest comes from shareObituary.json, which web also reads)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "textTitle",
    "textCaption",
    "editLabel",
    "editPlaceholder",
    "emailNoText",
    "emailBlanks",
    "publisherEmailLabel",
    "publisherEmailPlaceholder",
    "publisherEmailHint",
    "publisherEmailMany",
    "publisherEmailInvalid",
    "doneButton",
    "doneHint",
    "emailOpened",
    "emailShared"
  ],
  "properties": {
    "textTitle": {
      "$ref": "#/$defs/text"
    },
    "editLabel": {
      "$ref": "#/$defs/text"
    },
    "editPlaceholder": {
      "$ref": "#/$defs/text"
    },
    "emailNoText": {
      "$ref": "#/$defs/text"
    },
    "emailBlanks": {
      "$ref": "#/$defs/text"
    },
    "publisherEmailLabel": {
      "$ref": "#/$defs/text"
    },
    "publisherEmailPlaceholder": {
      "$ref": "#/$defs/text"
    },
    "publisherEmailHint": {
      "$ref": "#/$defs/text"
    },
    "publisherEmailMany": {
      "$ref": "#/$defs/text"
    },
    "publisherEmailInvalid": {
      "$ref": "#/$defs/text"
    },
    "doneButton": {
      "$ref": "#/$defs/text"
    },
    "doneHint": {
      "$ref": "#/$defs/text"
    },
    "emailOpened": {
      "$ref": "#/$defs/text"
    },
    "emailShared": {
      "$ref": "#/$defs/text"
    },
    "textCaption": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
