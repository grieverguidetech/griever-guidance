{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the phone-only person screen: heading, intro, partial-send line",
  "type": "object",
  "additionalProperties": false,
  "required": ["heading", "intro", "sentPartial"],
  "properties": {
    "heading": { "$ref": "#/$defs/text" },
    "intro": { "$ref": "#/$defs/text" },
    "sentPartial": { "$ref": "#/$defs/text" }
  },
  "$defs": { "text": { "type": "string", "minLength": 1 } }
}
