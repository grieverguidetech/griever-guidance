{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copy for the phone-only Texting screen: the links above the bottom bar (the rest comes from sending.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["notYetOpenAgain", "skipPerson"],
  "properties": {
    "notYetOpenAgain": { "$ref": "#/$defs/text" },
    "skipPerson": { "$ref": "#/$defs/text" }
  },
  "$defs": { "text": { "type": "string", "minLength": 1 } }
}
