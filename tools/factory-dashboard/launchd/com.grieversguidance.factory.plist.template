  <string>com.grieversguidance.factory</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PNPM__</string>
    <string>factory</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
